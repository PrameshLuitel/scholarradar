{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "uvicorn src.mcp_server.server:app --host 0.0.0.0 --port ${PORT:-10000}",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  },
  "services": {
    "scholar-radar-mcp": {
      "source": {
        "repo": "."
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "uvicorn src.mcp_server.server:app --host 0.0.0.0 --port ${PORT:-10000}"
      }
    },
    "scholar-radar-scheduler": {
      "source": {
        "repo": "."
      },
      "build": {
        "builder": "NIXPACKS"
      },
      "deploy": {
        "startCommand": "python -m src.scheduler.jobs"
      }
    }
  }
}
